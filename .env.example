# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin-actions

# Session Signing Secret (HMAC-SHA256 for HttpOnly Cookies)
SESSION_SECRET=replace-with-strong-random-64-char-hex-secret

# App Configuration
NEXT_PUBLIC_APP_NAME="CP Arena"
NEXT_PUBLIC_APP_DESCRIPTION="Competitive Programming Arena for University Students"
NEXT_PUBLIC_DEFAULT_STUDENT_DOMAIN="@cparena.internal"

# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-v3-secret-key


